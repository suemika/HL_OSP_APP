<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.pansoft</groupId>
    <artifactId>osp-starter-parent</artifactId>
    <version>6.6.7400</version>
  </parent>
  <groupId>com.pansoft</groupId>
  <artifactId>osp-lcdp-app</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>${my.packaging}</packaging>
  <name>osp-lcdp-app</name>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:${scm.url}</connection>
    <developerConnection>scm:git:${scm.url}</developerConnection>
    <tag>osp-demo-1.0.0</tag>
    <url>${scm.url}</url>
  </scm>
  <properties>
    <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
    <build.final.name>OSPApplication</build.final.name>
    <okhttp3.version>4.9.0</okhttp3.version>
    <distribution.release.url></distribution.release.url>
    <scm.url></scm.url>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-starter-auth</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-platform-base-file</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-platform-front-config</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-starter-log-db</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-starter-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-platform-develop</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-platform-metadata-manager</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-platform-form-manager</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-platform-service-manager</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-platform-bizmodel-manager</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-platform-bizmodel-convert</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-platform-mdm-manager</artifactId>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-platform-flow-builder</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-platform-portal</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-platform-flow-driver</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-starter-db-update</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-starter-cloud-config-zookeeper</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-platform-mobile-service</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-platform-flow-center</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-starter-cache-redis-jedis</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.hutool</groupId>
      <artifactId>hutool-all</artifactId>
      <version>5.7.11</version>
    </dependency>
    <dependency>
      <groupId>com.pansoft</groupId>
      <artifactId>osp-platform-minio-manager</artifactId>
    </dependency>
  </dependencies>
  <build>
    <finalName>${build.final.name}</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>copy-webinf</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/${build.final.name}/WEB-INF</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/resources/WEB-INF</directory>
                  <excludes>
                    <exclude>lib/*</exclude>
                  </excludes>
                  <includes>
                    <include>**/*</include>
                  </includes>
                  <filtering>false</filtering>
                </resource>
              </resources>
              <encoding>UTF-8</encoding>
            </configuration>
          </execution>
          <execution>
            <id>copy-config</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/${build.final.name}/WEB-INF/classes</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/resources</directory>
                  <includes>
                    <include>**/*</include>
                  </includes>
                  <excludes>
                    <exclude>WEB-INF/**</exclude>
                  </excludes>
                  <filtering>false</filtering>
                </resource>
              </resources>
              <encoding>UTF-8</encoding>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>jar</id>
      <activation>
        <property>
          <name>my.packaging</name>
          <value>jar</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.1.2</version>
            <executions>
              <execution>
                <id>copy-dependencies</id>
                <phase>package</phase>
                <goals>
                  <goal>copy-dependencies</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/${build.final.name}/lib</outputDirectory>
                  <excludeTransitive>false</excludeTransitive>
                  <stripVersion>false</stripVersion>
                  <overWriteReleases>false</overWriteReleases>
                  <overWriteSnapshots>false</overWriteSnapshots>
                  <overWriteIfNewer>true</overWriteIfNewer>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <artifactId>maven-jar-plugin</artifactId>
            <version>3.1.0</version>
            <configuration>
              <outputDirectory>${project.build.directory}/${build.final.name}/</outputDirectory>
              <archive>
                <manifest>
                  <addClasspath>true</addClasspath>
                  <classpathPrefix>lib</classpathPrefix>
                  <mainClass>com.pansoft.lcdp.OSPApplication</mainClass>
                </manifest>
                <manifestEntries>
                  <Class-Path>WEB-INF/classes/</Class-Path>
                </manifestEntries>
              </archive>
              <includes>
                <include>**/*.class</include>
              </includes>
            </configuration>
          </plugin>
        </plugins>
      </build>
      <properties>
        <my.packaging>jar</my.packaging>
      </properties>
    </profile>
    <profile>
      <id>war</id>
      <activation>
        <activeByDefault>true</activeByDefault>
        <property>
          <name>my.packaging</name>
          <value>war</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-war-plugin</artifactId>
            <version>3.1.0</version>
            <configuration>
              <packagingExcludes>WEB-INF/classes/WEB-INF/**</packagingExcludes>
              <webResources>
                <resource>
                  <directory>src/main/resources/WEB-INF</directory>
                  <targetPath>WEB-INF</targetPath>
                  <filtering>false</filtering>
                  <excludes>
                    <exclude>lib/*</exclude>
                  </excludes>
                  <includes>
                    <include>**/*</include>
                  </includes>
                </resource>
              </webResources>
            </configuration>
          </plugin>
        </plugins>
      </build>
      <properties>
        <my.packaging>war</my.packaging>
      </properties>
    </profile>
  </profiles>
</project>
