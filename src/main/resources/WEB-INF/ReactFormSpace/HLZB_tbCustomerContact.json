        "onClick" : "\r\nfunction openContactDrawer() {\r\n    debugger;\r\n    let selectedCustomerRow = AGGrid1.getSelectedRowSet();\r\n    if (!selectedCustomerRow) {\r\n        console.error(\"请先在客户列表中选中一行\");\r\n        return;\r\n    }\r\n\r\n    let customerId = selectedCustomerRow.getString(\"customer_id\");\r\n    if (!customerId || customerId === \"\") {\r\n        console.error(\"选中的客户行中未获取到customer_id\");\r\n        return;\r\n    }\r\n\r\n    modelContainer.setValue(\"currentCustomerId\", customerId);\r\n    modelContainer.setValue(\"currentCustomerRow\", selectedCustomerRow);\r\n\r\n    ReactFormDrawerAction1.doAction({\r\n        type: \"edit\", \r\n        bindCustomerId: customerId\r\n    });\r\n}\r\n\r\n\r\nfunction initContactAddData() {\r\n    debugger;\r\n \r\n    let customerId = modelContainer.getValue(\"currentCustomerId\", null);\r\n    if (!customerId) {\r\n        console.error(\"未获取到关联的客户ID，无法初始化联系人数据\");\r\n        return;\r\n    }\r\n\r\n    let newContactRow = new Row(); \r\n    \r\n    newContactRow.putString(\"customer_id\", customerId);\r\n\r\n    \r\n    let po = new JParamObject();\r\n    let currentUser = po.getEnv(\"UserName\"); \r\n    newContactRow.putString(\"F_CRUSER\", currentUser); \r\n    newContactRow.putString(\"shStatus\", \"0\"); \r\n    newContactRow.putString(\"AUDIT_TIME\", \"-\"); \r\n\r\n\r\n    modelContainer.setValue(\"addedContactRow\", newContactRow);\r\n\r\n\r\n    let dataset = new EFDataSet();\r\n    dataset.setTableName(\"HLZB_tbCustomerContact\"); \r\n    dataset.insertRowSet(newContactRow); \r\n    let mdmDataModel = new EFMDMDataModel();\r\n    mdmDataModel.setDCT_ID(\"HLZB_tbCustomerContact\");\r\n    mdmDataModel.setDataSet(\"HLZB_tbCustomerContact\", dataset);\r\n\r\n    ContactMDModel.setMdmDataModel(mdmDataModel);\r\n    ContactMDModel.startEdit(); \r\n}",
        "beforeCreateMdmItem" : "",
        "doAction" : ""
      },
      "style" : { }
    },
