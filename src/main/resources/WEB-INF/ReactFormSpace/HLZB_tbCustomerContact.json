  "rootProps" : {
    "scriptsCode" : {
      "componentDidMount" : "\r\nfunction bindCustomerIdToContact(customerRow, contactRow) {\r\n    if (!customerRow || !customerRow.customer_id) {\r\n        console.error(\"主表客户数据或customer_id不存在，无法关联\");\r\n        return contactRow;\r\n    }\r\n\r\n    if (!contactRow) {\r\n        contactRow = {};\r\n        console.log(\"联系人行数据为空，已初始化新对象\");\r\n    }\r\n    \r\n    // 绑定外键（子表customer_id = 主表customer_id）\r\n    contactRow.customer_id = customerRow.customer_id;\r\n    console.log(`已关联客户ID: ${customerRow.customer_id} 到联系人数据`);\r\n    \r\n    return contactRow;\r\n}\r\n\r\nlet customerMainRow = modelContainer.getValue(\"customerSelectedRow\", null); \r\nlet contactAddRow = config.Row;\r\n\r\nif (customerMainRow && contactAddRow) {\r\n    contactAddRow = bindCustomerIdToContact(customerMainRow, contactAddRow);\r\n}\r\n\r\nif (contactAddRow && contactAddRow !== \"\") {\r\n    let dataset = new EFDataSet();\r\n    dataset.setTableName(\"HLZB_tbCustomerContact\"); \r\n    dataset.insertRowSet(contactAddRow); \r\n    let mdmDataModel = new EFMDMDataModel();\r\n    mdmDataModel.setDCT_ID(\"HLZB_tbCustomerContact\");\r\n    mdmDataModel.setDataSet(\"HLZB_tbCustomerContact\", dataset);\r\n    ContactMDModel.setMdmDataModel(mdmDataModel); \r\n}\r\n"
    },
