      "scriptsCode" : {
        "doAction" : "// (保存)GeneralAction1.doAction\ndebugger;\n    var a = FormTextPassword1.getValue();\n    var b = FormTextPassword2.getValue();\n    var c = FormTextPassword3.getValue();\n    //空\n    if(c== null || c==\"\"){\n        window.showAlertMsg('系统提示', '当前密码不能为空！', '1', '确定', null);\n    \treturn \"0\";\n    }\n    if(a== null || a==\"\" || b== null || b==\"\"){\n        window.showAlertMsg('系统提示', '密码不能为空！', '1', '确定', null);\n    \treturn \"0\";\n    }\n    //不等\n    if(a != b){\n    \twindow.showAlertMsg('系统提示', '两次输入的密码不一致！', '1', '确定', null);\n    \treturn \"0\";\n    }\n    \n    //密码格式验证\n    // var re = /^(?=.*?[A-Z])(?=.*?[a-z])(?=.*?[0-9])(?=.*?[^\\w\\s]).{8,15}$/;\n    // if(!re.test(a)){\n    //      window.showAlertMsg('系统提示', '密码必须含有大小写字母、数字以及特殊字符，且在8~15位之间！', '1', '确定', null);\n    //   \t//FormLabel3.setObject(\"*新密码：\");\n    //  \t//FormLabel4.setObject(\"*重复密码：\");\n    //      return \"0\";\n    //  }\n    let F_ZGBH = modelContainer.getValue('F_ZGBH',null);\n    \n    var PO = new JParamObject();\n    PO.setValue(\"F_ZGBH\", F_ZGBH);\n    PO.setValue(\"F_PASS\", a);\n    var man = EAI.getEnv(\"F_MANA\",\"\");\n    if(man == \"9\" || man == \"1\"){\n        PO.setValue(\"MODE\", \"0\");\n    }else{\n        PO.setValue(\"MODE\", \"1\");\n    }\n    PO.setValue(\"CHECK_PASS\", c);\n    PO.setValue(\"UserName\",PO.getEnv(\"UserName\",\"\")) ;\n    \n    WebService1.IOM(\"SecurityObject\",\"reSetUserPass\",PO);"
