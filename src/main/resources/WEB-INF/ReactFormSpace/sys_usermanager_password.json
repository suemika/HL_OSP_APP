      "scriptsCode" : {
        "callFunction" : "// (密码修改-回调函数)FunctionComp1.callFunction\ndebugger;\nvar dataSet = Object.assign(new EFDataSet(), data.ResponseObject);\nvar errorCode= data.getErrorCode();\nif(errorCode==0)\n{\n        window.showAlertMsg('系统提示', '修改密码成功！', '0', '确定', null);\n        WindowExitAction1.doAction();\n        return \"0\";\n        \n}else\n{\n\twindow.showAlertMsg('系统提示', '修改密码失败:'+data.getErrorString(), '1', '确定', null);\n\tWindowExitAction1.doAction();\n\treturn \"0\";\n\n}\n"
      },
