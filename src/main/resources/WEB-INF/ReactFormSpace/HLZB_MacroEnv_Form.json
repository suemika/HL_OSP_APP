      "componentDidMount" : "debugger;\nlet Row =modelContainer.getValue(\"Row\",null)\nvar config = modelContainer.getValue(\"config\",null);\nvar shbh = modelContainer.getValue(\"shbh\",null);\nconsole.log(\"获取到的config：\", config);\nconsole.log(\"获取到的Row：\", config.Row);\n\nlet addRow = config.Row;\nlet type=config.type;\nlet AGGrid1 = config.AGGrid1;\n//var name = addRow.getString(\"AUDIT_BY\")\n// DataSetFieldComboBox1.setValue(name)\n// DataSetFieldComboBox1.forceUpdate()\nif(type=='create'){\n    FormComboBox1.stopEdit();\n    \n}\nif(type=='edit'){\n    FormComboBox1.stopEdit();\n    \n}\nif(type=='show'){\n    MDModel1.stopEdit();\n   \n   FormButton2.setVisible(false);\n}\nif(type=='shenhe' ){\n   FormComboBox1.startEdit();\n   FormTextInput2.stopEdit();\n   FormTextArea1.stopEdit();\n   DataSetFieldComboBox1.stopEdit();\n}\n\n\n\nif(addRow != null && addRow != \"\"){\n   \n        let dataset = new EFDataSet();\n        dataset.setTableName(\"HLZB_tbMacroEnv\");\n        dataset.insertRowSet(addRow);\n        let mdmDataModel = new EFMDMDataModel();\n        mdmDataModel.setDCT_ID(\"HLZB_tbMacroEnv\");\n        mdmDataModel.setDataSet(\"HLZB_tbMacroEnv\",dataset);\n        MDModel1.setMdmDataModel(mdmDataModel);\n    \n    \n\n    \n}\n\n\n\n\n\n"
