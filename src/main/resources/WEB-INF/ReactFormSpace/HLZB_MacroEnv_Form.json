          "scriptsCode" : {
            "onClick" : "// (按钮)FormButton2.onClick\n// (确定)FormButton1.onClick\ndebugger;\nlet flag = MDModel1.checkCompNotNull();\n//校验非空\nif(!flag){\n    let Row = modelContainer.getValue('Row',null);\n    var config = modelContainer.getValue('config',null);\n    var shij = modelContainer.getValue('shij',null);\n    var  shzt= modelContainer.getValue('shzt',null);\n    let Rows = config.Row;\n    let type = config.type;\n   \n    var infoName = Rows.getString(\"infoName\",\"\");\n    if(infoName == null || infoName == \"\"||infoName.trim()==\"\"){\n        window.showAlertMsg('系统提示', '信息名称不能为空！', '1', '确定', null);\n        return \"0\";\n    }\n    \n   \n    if(type==\"shenhe\" && shzt==\"1\"){\n        const now = new Date();\n        const year = now.getFullYear();\n        const month = String(now.getMonth() + 1).padStart(2, '0'); // 月份从0开始，补0\n        const day = String(now.getDate()).padStart(2, '0');\n        const hours = String(now.getHours()).padStart(2, '0');\n        const minutes = String(now.getMinutes()).padStart(2, '0');\n        const seconds = String(now.getSeconds()).padStart(2, '0');\n        \n        // 拼接为完整时间字符串\n        const sj = `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;\n        \n        console.log(\"时间为：\" + sj);\n        Rows.putString(\"AUDIT_TIME\",sj)\n        MDModel1.getMdmDataModel().getDataSet(\"HLZB_tbDownstreamIndustry\").getRowSetArray[0].putString(\"AUDIT_TIME\",sj)\n       \n        let save = modelContainer.getValue('config',null).saveAction;\n        save.setSaveTip('审核成功!'); \n        save.doAction();\n        return;\n    }\n    let save = modelContainer.getValue('config',null).saveAction;\n    save.setSaveTip('保存成功!');\n    save.doAction();\n    // let ym = FormExtendPropertiesField1.getValue();\n    // Row.putObject(\"COL_VIEW\",ym);\n\n    WindowExitAction1.doAction();\n \n}\n",
