/**
 * Create a new id generator / cache instance.
 *
 * You may optionally provide a seed that is used internally.
 *
 * @param {Seed} seed
 */
function BIMIds(seed) {

  if (!(this instanceof BIMIds)) {
    return new BIMIds(seed);
  }

  seed = seed || [ 128, 36, 1 ];
 this._seed = seed.length ? bimhat.rack(seed[0], seed[1], seed[2]) : seed;
}

module.exports = BIMIds;

/**
 * Generate a next id.
 *
 * @param {Object} [element] element to bind the id to
 *
 * @return {String} id
 */
BIMIds.prototype.next = function(element) {
  return this._seed(element || true);
};

/**
 * Generate a next id with a given prefix.
 *
 * @param {Object} [element] element to bind the id to
 *
 * @return {String} id
 */
BIMIds.prototype.nextPrefixed = function(element) {
    var id;
    var i = 1;
  do {
      var type = element.$type;
      if(type == 'bpmn:StartEvent'){
         i==1? id = 'start': id = 'start_' + i;
      }else if(type == 'bpmn:EndEvent'){
          i==1? id =  'end': id ='end_' + i;
      }else if(type == 'bpmn:Task'){
          id = 'S_' + i;
      }else if(type == 'bpmn:SequenceFlow'){
          id = 'R_' + i;
      }
      i++;
  } while (this.assigned(id));

  // claim {prefix}{random}
  this.claim(id, element);

  // return
  return id;
};

/**
 * Manually claim an existing id.
 *
 * @param {String} id
 * @param {String} [element] element the id is claimed by
 */
BIMIds.prototype.claim = function(id, element) {
  this._seed.set(id, element || true);
};

/**
 * Returns true if the given id has already been assigned.
 *
 * @param  {String} id
 * @return {Boolean}
 */
BIMIds.prototype.assigned = function(id) {
  return this._seed.get(id) || false;
};

/**
 * Unclaim an id.
 *
 * @param  {String} id the id to unclaim
 */
BIMIds.prototype.unclaim = function(id) {
  delete this._seed.bimhats[id];
};


/**
 * Clear all claimed ids.
 */
BIMIds.prototype.clear = function() {
  var bimhats = this._seed.bimhats,
