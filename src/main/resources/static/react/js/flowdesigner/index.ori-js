        submitBillDataUpdateMapGroup,
        rollbackBillDataUpdateMapGroup,
        ratakeBillDataUpdateMapGroup
    ];
}
function OSPFlowPropertiesProvider(eventBus, bpmnFactory, elementRegistry, commandStack) {

    PropertiesActivator.call(this, eventBus);

    this.getTabs = function (element) {

        var generalTab = {
            id: 'general',
            label: '属性',
            groups: createGeneralTabGroups(element, bpmnFactory, elementRegistry, commandStack)
        };

        var formsTab = {
            id: 'forms',
            label: '表单',
            groups: createFormsTabGroups(element, bpmnFactory, elementRegistry, commandStack)
        };

        var serviceTab = {
            id: 'service',
            label: '服务',
            groups: createServiceTabGroups(element, bpmnFactory, elementRegistry, commandStack)
        };

        var advancedTab = {
            id: 'advanced',
            label: '高级属性',
            groups: createAdvanceTabGroups(element, bpmnFactory, elementRegistry, commandStack)
        };
        if(window.isUsePlatform){
            return [
                generalTab,
                formsTab,
                serviceTab
                //advancedTab//注释调这一个，配置了属性，只允许在表单中设置
            ];
        }else{
            return [
                generalTab,
               // formsTab,
                serviceTab
                //advancedTab//注释调这一个，配置了属性，只允许在表单中设置
            ];
        }

    };
}
inherits(OSPFlowPropertiesProvider, PropertiesActivator);

module.exports = OSPFlowPropertiesProvider;

