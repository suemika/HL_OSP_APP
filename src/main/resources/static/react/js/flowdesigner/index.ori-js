/**
 * 当加载完成后，将所有虚拟节点的出边设置为虚拟边
 * @param bpmnModeler
 */
flowPropertyUtil.updateVirtualEdge = function(bpmnModeler) {
    bpmnModeler.invoke(function (commandStack) {
        var elementRegistry = bpmnModeler.get('elementRegistry');
        var eles = elementRegistry._elements;
        var properties = {};
        for(var key in eles){
            var businessObject;
            var ele = eles[key].element;
            var type = ele.type;
            if(type != 'bpmn:Task' && type != 'bpmn:StartEvent'){
                continue;
            }
            var businessObject = ele.businessObject;
            if(businessObject == null ){
                continue;
            }
            var virtualNode = businessObject.virtualNode;
            if(virtualNode != true){
                continue;
            }
            var outgoings = ele.outgoing;
            var outgoingPropertise = {virtualEdge: true};
            for(var i=0; i<outgoings.length; i++){
                var outgoing  = outgoings[i];
                // 执行普通属性更新操作
                var cmd = cmdHelper.updateProperties(outgoing, outgoingPropertise);
                commandStack.execute(cmd.cmd, cmd.context || {element : outgoing});
            }
        }
    });
}

module.exports = flowPropertyUtil;
