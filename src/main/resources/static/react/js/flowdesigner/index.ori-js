            };
            //设置全局，可以在GWT中取到哪个元素选中了 只包含节点和线的
            window.getSelectionElementId = function(){
                var type = element.type;
                if(type == 'bpmn:StartEvent' || type == 'bpmn:Task' ||type == 'bpmn:EndEvent' ||type == 'bpmn:SequenceFlow' ){
                    var id = element.businessObject.id;
                    return id;
                }
                return '';//返回空
            };
            window.getSelectionElementScriptMap = function(){
                var type = element.type;
                if(type == 'bpmn:StartEvent' || type == 'bpmn:Task' ||type == 'bpmn:EndEvent' ||type == 'bpmn:SequenceFlow' ){
                    // 当前节点的函数脚本
                    var scriptMap = {};
                    var bo = element.businessObject;
                    var extensionElements = bo.extensionElements;
                    if ( extensionElements ) {
                        var scriptElements = getScriptsElementInsideExtensionElements(extensionElements);
                        if ( scriptElements ) {
                            var scripts = scriptElements.get('customFunction');
                            for ( var i = 0; scripts && i < scripts.length; i++ ) {
                                var scriptElement = scripts[i];
