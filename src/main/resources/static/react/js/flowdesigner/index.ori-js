var clickEventConfig = function(bpmnModeler){
   //注册点击事件 调用GWT中的方法，执行点击事件中的脚本
    bpmnModeler.invoke(function (eventBus, bpmnFactory, commandStack) {
        eventBus.on('element.click', function(event) {
            var type = event.element.type;
            var element = event.element;
            setSelectElement(element, commandStack);
            var property =  propertyUtil.getElementAllProperty(event.element.businessObject);
            var propObj = propertyUtil.formatProps(property);
            propObj["FlowId"] = flowInfo.flowId;//流程id
            propObj["FlowSys"] = window.FlowSys;//所在系统
            window.designer.elementClick(type, element, propObj);
        });
        eventBus.on('element.dblclick', function(event) {
            var type = event.element.type;
            var element = event.element;
            setSelectElement(element, commandStack);
            var property =  propertyUtil.getElementAllProperty(event.element.businessObject);
            var propObj = propertyUtil.formatProps(property);
            propObj["FlowId"] = flowInfo.flowId;//流程id
            propObj["FlowSys"] = window.FlowSys;//所在系统
            window.designer.elementDoubleClick(type, element, propObj);
        });
        eventBus.on('element.rightmousedown', function(event) {
            var type = event.element.type;
            var element = event.element;
            setSelectElement(element, commandStack);
            var property = propertyUtil.getElementAllProperty(event.element.businessObject);
            var propObj = propertyUtil.formatProps(property);
            propObj["FlowId"] = flowInfo.flowId;//流程id
            propObj["FlowSys"] = window.FlowSys;//所在系统
            window.designer.elementRightMouseDown(type, element, propObj);
        });

