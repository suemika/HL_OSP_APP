                return{};
            }
             var extension =  element.businessObject.extensionElements;
            if(extension == null || extension == undefined) return{};
            var map = extension.values;
            for(var i=0; i < map.length; i++){
                //解析是什么参数
                var type = map[i].$type;
                var key = type.split(":")[1];
                if(key == "customFunction" || key != prop ) continue;
                var childMap = {};
                var childprop  =  map[i].values;
                if(childprop == undefined ||childprop == null) continue;
                for(var j=0; j<childprop.length; j++){
                    childMap[childprop[j].name] = childprop[j].value;
                }
            }
            return childMap;
        }

        //设置元素的所有的属性
        window.setElementProperty = function(elementId, property) {
            propertyUtil.updateProps(elementId, property, bpmnModeler, bpmnFactory,commandStack);
        }
        //设置元素的单个普通属性 value为字符串或者对象{name:zs; age:12}
        window.setSingleElementProperty = function(elementId,key, value) {
