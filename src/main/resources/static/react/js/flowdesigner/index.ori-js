            menuitem.className = 'menuitem';
            //根据内容显示菜单
            var type = event.element.type;
            if(type == "bpmn:StartEvent" || type=="bpmn:Task" || type =="bpmn:EndEvent" ){
                contextmenu.style.display = "block";
                menuitem.innerHTML = '设置节点属性';
                menuitem.onclick = function(e) {
                    var e = e || window.event;
                    contextmenu.style.display = "none"
                    e.cancelBubble = true;
                    var property = propertyUtil.getElementAllProperty(event.element.businessObject);
                    var propObj = propertyUtil.formatProps(property);
                    propObj["FlowId"] = flowInfo.flowId;//系统id
                    var nodeList = addIncomeNode(event.element.businessObject);//来源节点数据集
                    var lineList = addIncomeLine(event.element.businessObject);//来源边数据集
