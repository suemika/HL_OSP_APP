'use strict';

var inherits = require('inherits');

var PropertiesActivator = require('bpmn-js-properties-panel/lib/PropertiesActivator');

var processProps = require('bpmn-js-properties-panel/lib/provider/bpmn/parts/ProcessProps'),
    eventProps = require('bpmn-js-properties-panel/lib/provider/bpmn/parts/EventProps'),
    linkProps = require('bpmn-js-properties-panel/lib/provider/bpmn/parts/LinkProps');

// 边属性
var sequenceFlowGeneralProps = require('./parts/SequenceFlowProps/SequenceFlowGeneralProps'),
    sequenceFlowCommonProps = require('./parts/SequenceFlowProps/SequenceFlowCommonProps'),
    sequenceFlowOthersProps = require('./parts/SequenceFlowProps/SequenceFlowOthersProps'),
    SequenceFlowServiceProps = require('./parts/SequenceFlowProps/SequenceFlowServiceProps');

var scriptProps = require('./parts/ScriptProps');
var AttriMapPropeties = require('./parts/AttriMapProps');

// 节点属性
var taskGeneralProps = require('./parts/TaskProps/TaskGeneralProps'),
    taskCommonProps = require('./parts/TaskProps/TaskCommonProps'),
    taskMergeProps = require('./parts/TaskProps/TaskMergeProps'),
    taskGroupProps = require('./parts/TaskProps/TaskGroupProps'),
    taskOthersProps = require('./parts/TaskProps/TaskOthersProps'),
    taskServiceProps = require('./parts/TaskProps/TaskServiceProps');

var htmlformsProps = require('./parts/FormProps/HtmlFormsProps'),
    flexformsProps = require('./parts/FormProps/FlexFormsProps'),
    phoneformsProps = require('./parts/FormProps/PhoneFormsProps'),
    padformsProps = require('./parts/FormProps/PadFormsProps'),
    generalformsProps = require('./parts/FormProps/GeneralFormsProps'),
    approvalFormsProps = require('./parts/FormProps/ApprovalFormsProps');

var splitAttrMapProps = require('./parts/SplitAttrMapProps'),
    addDataMapProps = require('./parts/AddDataMapProps'),
    billDataUpdateMapProps = require('./parts/BillDataUpdateMapProps'),
    submitBillDataUpdateMapProps = require('./parts/SubmitBillDataUpdateMapProps'),
    rollbackBillDataUpdateMapProps = require('./parts/RollbackBillDataUpdateMapProps'),
    ratakeBillDataUpdateMapProps = require('./parts/RetakeBillDataUpdateMapProps');

// 流程属性
var ProcessGeneralProps = require('./parts/ProcessProps/ProcessGeneralProps'),
    ProcessCommonProps = require('./parts/ProcessProps/ProcessCommonProps'),
    ProcessOthersProps = require('./parts/ProcessProps/ProcessOthersProps'),
    ProcessServiceProps = require('./parts/ProcessProps/ProcessServiceProps');

var  domClasses = require('min-dom/lib/classes');
// 基本属性Tab
function createGeneralTabGroups(element, bpmnFactory, elementRegistry, commandStack) {

    var generalGroup = {
        id: 'general',
        label: '基本属性',
        entries: []
    };
    processProps(generalGroup, element);
    taskGeneralProps(generalGroup, element, bpmnFactory, commandStack);
    sequenceFlowGeneralProps(generalGroup, element, bpmnFactory, commandStack);
    ProcessGeneralProps(generalGroup, element, bpmnFactory, commandStack);

    // 这是个什么分组？ comment by liuguozhen at 2021.03.01 14:52
    var detailsGroup = {
        id: 'details',
        label: 'Details',
        entries: []
    };
    linkProps(detailsGroup, element);
    eventProps(detailsGroup, element, bpmnFactory, elementRegistry);

    var commonGroup = {
        id: 'common',
        label: '常用属性',
        entries: [],
        close:true
    }
    taskCommonProps(commonGroup, element, commandStack);
    sequenceFlowCommonProps(commonGroup, element, commandStack);
    ProcessCommonProps(commonGroup, element, commandStack);
    // 自定义函数
    scriptProps(commonGroup, element, bpmnFactory, commandStack);

    var taskMergeGrop = {
        id: 'merge',
        label: '会签拆分属性',
        entries: [],
        close:true
    }
    taskMergeProps(taskMergeGrop, element, bpmnFactory);

    // 新增聚合节点属性栏 add by liuguozhen at 2021.03.01 10:56 
    var taskGroupGrop = {
        id: 'group',
        label: '聚合节点属性',
        entries: [],
        close:true
    }
    taskGroupProps(taskGroupGrop, element, bpmnFactory);

    var attriMapGroup = {
        id: 'attriMap',
        label: '扩展属性',
        entries: [],
        close:true
    };
    AttriMapPropeties(attriMapGroup, element, bpmnFactory);

    var othersGroup = {
        id: 'others',
        label: '其它属性',
        entries: [],
        close:true
    };
    taskOthersProps(othersGroup, element, bpmnFactory, commandStack);
    sequenceFlowOthersProps(othersGroup, element);
    ProcessOthersProps(othersGroup, element);

    // 从url中获取是否加载精简设计器的参数
    var isLoadSimplifiedDesigner = getQueryString("simplified");
    if ("1" != isLoadSimplifiedDesigner) {
        return[
            generalGroup,
            commonGroup,
            detailsGroup,
            taskMergeGrop,
            taskGroupGrop,
            attriMapGroup,
            othersGroup
        ];
    } else {
        return[
            generalGroup,
            commonGroup,
            detailsGroup,
            // taskMergeGrop,
            // taskGroupGrop,
            attriMapGroup
            // othersGroup
        ];
    }
}

// 从url中获取?后的参数
function getQueryString(name) {
    var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
    var r = window.location.search.substr(1).match(reg);
    if (r != null) return unescape(r[2]);
    return null;
}

// 节点FormsTab
function createFormsTabGroups(element, bpmnFactory, elementRegistry, commandStack) {

    var htmlFormsGroup = {
        id: 'htmlForms',
        label: '业务表单',
        entries: []
    };
    htmlformsProps(htmlFormsGroup, element, bpmnFactory, commandStack);

    var flexFormsGroup = {
        id: 'flexForms',
        label: 'flex任务处理表单',
        entries: [],
        close:true
    };
    flexformsProps(flexFormsGroup, element, bpmnFactory, commandStack);

    var padFormsGroup = {
        id: 'PadForms',
        label: 'Pad任务处理表单',
        entries: [],
        close:true
    };
    padformsProps(padFormsGroup, element, bpmnFactory, commandStack);

    var phoneFormsGroup = {
        id: 'PhoneForms',
        label: 'Phone任务处理表单',
        entries: [],
        close:true
    };
    phoneformsProps(phoneFormsGroup, element, bpmnFactory, commandStack);

    var isProcess = element.type == "bpmn:Process";
    var lable = "swing任务处理表单";
    if(isProcess){
        lable= "业务表单"
    }
    var generalFormsGroup = {
        id: 'generalForms',
        label: lable,
        entries: [],
        close:!isProcess
    };
    generalformsProps(generalFormsGroup, element, bpmnFactory, commandStack);

    // 审批表单属性 add by liuguozhen at 2021.03.18 11:49
    var approvalFormsGroup = {
        id: 'approvalForms',
        label: "审批表单",
        entries: [],
        close:true
    };
    approvalFormsProps(approvalFormsGroup, element, commandStack);

    // 删除flex、swing等目前没有用的属性 modified by liuguozhen at 2020.06.04 16:53
    if (isProcess) {
        return [
            htmlFormsGroup,
            // flexFormsGroup,
            // phoneFormsGroup,
            // padFormsGroup,
            generalFormsGroup,
            approvalFormsGroup
        ];
    } else {
        return [
            htmlFormsGroup,
            // flexFormsGroup,
            // phoneFormsGroup,
            // padFormsGroup,
            // generalFormsGroup,
            approvalFormsGroup
        ];
    }
}

// 服务属性设置
function createServiceTabGroups(element, bpmnFactory, elementRegistry, commandStack) {

    var serviceGroup = {
        id: 'service',
        label: '任务处理服务',
        entries: []
    };


    taskServiceProps(serviceGroup, element, bpmnFactory, commandStack);
    SequenceFlowServiceProps(serviceGroup, element, bpmnFactory, commandStack);
    ProcessServiceProps(serviceGroup, element, bpmnFactory, commandStack);
    return [
        serviceGroup
    ];
}
// 高级属性设置
function createAdvanceTabGroups(element, bpmnFactory, elementRegistry, commandStack) {

    var splitGroup = {
        id: 'splitAttrMap',
        label: '流程拆分依据',
        entries: []
    };
    splitAttrMapProps(splitGroup, element, bpmnFactory, commandStack);

    var addDataMapGroup = {
        id: 'addDataMap',
        label: '流程附加数据设置',
        entries: []
    };
    addDataMapProps(addDataMapGroup, element, bpmnFactory, commandStack);

    var billDataUpdateMapGroup = {
        id: 'billDataUpdateMap',
        label: '数据更新设置',
        entries: []
    };
    billDataUpdateMapProps(billDataUpdateMapGroup, element, bpmnFactory, commandStack);

    var submitBillDataUpdateMapGroup = {
        id: 'submitBillDataUpdateMap',
        label: '提交数据更新设置',
        entries: []
    };
    submitBillDataUpdateMapProps(submitBillDataUpdateMapGroup, element, bpmnFactory, commandStack);

    var rollbackBillDataUpdateMapGroup = {
        id: 'rollbackBillDataUpdateMap',
        label: '退回数据更新设置',
        entries: []
    };
    rollbackBillDataUpdateMapProps(rollbackBillDataUpdateMapGroup, element, bpmnFactory, commandStack);

    var ratakeBillDataUpdateMapGroup = {
        id: 'ratakeBillDataUpdateMap',
        label: '取回数据更新设置',
        entries: []
    };
    ratakeBillDataUpdateMapProps(ratakeBillDataUpdateMapGroup, element, bpmnFactory, commandStack);


