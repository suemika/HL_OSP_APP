/**
 * 获取一个节点的前面的所有的节点
 * @param ModdleElement element
 * @param nodeList 节点集合 例子：{start:开始, end:结束} key是nodeTag
 */
function addIncomeNode(element, nodeList, nodeIdList){
    if(nodeList == null || nodeList == undefined) nodeList = {};
    if(nodeIdList == null || nodeIdList == undefined) nodeIdList = {};
    var lineArray = element.incoming;
    if(lineArray == undefined || lineArray == null || lineArray.length == 0 ) return nodeList;
    for(var i=0; i<lineArray.length; i++){
        var line = lineArray[i];
        var sourceNode = line.sourceRef;
        //解决自循环的问题，存在的节点就不去处理了
        if( nodeIdList[sourceNode['id']] == sourceNode['id']) continue;
        nodeIdList[sourceNode['id']] = sourceNode['id'];

        nodeList[sourceNode['BIMId']] = sourceNode['name'];
        addIncomeNode(sourceNode, nodeList,nodeIdList);
    }
    return nodeList;
}
 /**
 * 获取一个节点的前面的所有的线
 * @param ModdleElement element
 * @param lineList 线集合  key是nodeTag
 */
 function addIncomeLine(element, lineList,lineIdList){
     if(lineList == null || lineList == undefined) lineList = {};
     if(lineIdList == null || lineIdList == undefined) lineIdList = {};
     var lineArray = element.incoming;
     if(lineArray == undefined || lineArray == null || lineArray.length == 0 ) return lineList;
     for(var i=0; i<lineArray.length; i++){
         var line = lineArray[i];
         //解决自循环的问题，存在的线就不去处理了
         if( lineIdList[line['id']] == line['id']) continue;
         lineIdList[line['id']] = line['id'];

         lineList[line['BIMId']] = line['name'];
         var sourceNode = line.sourceRef;
         addIncomeLine(sourceNode, lineList,lineIdList);
     }
     return lineList;
}

/**
 * 获取来源节点业务标识码和名称
 * @param element 线
 */
function getStartNode(element){
    var sourceNode = element.sourceRef;
    var prop = {
        BIMId:sourceNode["BIMId"],
        name: sourceNode["name"]
    };
    return prop;
}

/**
 * 获取目标节点业务标识码
 * @param element 线
 */
function getEndNode(element){
    var targetNode = element.targetRef;
    var prop = {
        BIMId:targetNode["BIMId"],
        name: targetNode["name"]
    };
    return prop;
}

/**
 *
 * @param element
 * @returns {*}
 */
function getStartNodeMDLID(element){
    var sourceNode = element.sourceRef;
    var modelID = sourceNode["modelID"]
    return modelID;
}

/**
 *
 * @param element
 * @returns {*}
 */
function getStartNodeAddDataMap(element){
    var sourceNode = element.sourceRef;
    var extensionElements = sourceNode["extensionElements"]
    if(extensionElements == null || extensionElements == undefined) return null;
    var addDataMap = {};
    var map = extensionElements.values;
    for(var i=0; i < map.length; i++){
        //解析是什么参数
        var type = map[i].$type;
        var key = type.split(":")[1];
        if(key != "AddDataMap") continue;
        var childprop  =  map[i].values;
        if(childprop == undefined ||childprop == null) continue;
        for(var j=0; j<childprop.length; j++){
            addDataMap[childprop[j].name] = childprop[j].value;
        }
    }
    return addDataMap;
}

/**
 * 获取来源边以及来源节点的来源边
 * @param element
 * @param properties
 */
function addInLine(element,properties) {
    if(properties == null || properties == undefined) properties = {};
    // 当前节点来源边
    var inBIMEdge = element.incoming;
    if (inBIMEdge != null) {
        // 来源节点
        var sourceNode = inBIMEdge[0].sourceRef;
        // 来源节点来源边
        var sourceNodeInBIMEdge = sourceNode.incoming;
        properties["srcEdgeId"] = sourceNodeInBIMEdge[0].BIMId;
        properties["srcNodeId"] = inBIMEdge[0].sourceRef.BIMId;
    }
}

module.exports = propConfig;
