            var property = propertyUtil.getElementAllProperty(event.element.businessObject);
            var propObj = propertyUtil.formatProps(property);
            propObj["FlowId"] = flowInfo.flowId;//流程id
            propObj["FlowSys"] = window.FlowSys;//所在系统
            window.designer.elementChange(type, element, propObj,operation);
        });

        eventBus.on('selection.changed', function(event) {
            var selections = event.newSelection;
            if(selections.length > 0 ){
                var element = selections[0];
                var type = element.type;
                setSelectElement(element, commandStack);
                var property = propertyUtil.getElementAllProperty(element.businessObject);
                var propObj = propertyUtil.formatProps(property);
                propObj["FlowId"] = flowInfo.flowId;//流程id
