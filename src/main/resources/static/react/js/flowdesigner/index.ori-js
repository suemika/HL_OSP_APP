},{}],6:[function(require,module,exports){
'use strict';

var $ = require('jquery'),
    BpmnModeler = require('bpmn-js/lib/Modeler');

// 从url中获取国际化标志参数 add by liuguozhen at 2020.05.18 16:49
var i18n = getQueryString("locale");
var ospflowModdleDescriptor = require('./descriptors/ospflow.json');
if ("en_US" == i18n) {
    ospflowModdleDescriptor = require('./descriptors/ospflow_en_US.json');
} else if ("ru_RU" == i18n) {
    ospflowModdleDescriptor = require('./descriptors/ospflow_ru_RU.json');
} else if ("es_ES" == i18n) {
    ospflowModdleDescriptor = require('./descriptors/ospflow_es_ES.json');
} else if ("fr_FR" == i18n) {
    ospflowModdleDescriptor = require('./descriptors/ospflow_fr_FR.json');
}

// 从url中获取是否只做展示的参数 add by liuguozhen at 2020.06.17 11:14
var onlyShow = getQueryString("onlyshow");
if ("1" == onlyShow) {
    window.isOnlyShow = true;
}

var propertiesPanelModule = require('bpmn-js-properties-panel'),
    propertiesProviderModule = require('./provider/ospflow');
var isArray = require('lodash/lang/isArray');
var container = $('#js-drop-zone');
var canvas = $('#js-canvas');

var OriginModule = require('diagram-js-origin');
var resizeAllModule = require('bpmn-js/lib/resize-all-rules');

var options = {
    container: canvas,
    additionalModules: [
        resizeAllModule
    ],
    moddleExtensions: {
        magic: ospflowModdleDescriptor
    }
};
if(window.isOnlyShow != true) {
    options.additionalModules = [
        OriginModule,
        resizeAllModule
    ];
}
if(window.isComponent != true){
    options.propertiesPanel =  {
        parent: '#js-properties-panel'
    };
}
options.additionalModules = [
    propertiesPanelModule,
    propertiesProviderModule,
    OriginModule,
    resizeAllModule
];

if(window.isHasTaskInfoShow != true && window.isOnlyShow != true){
    options.keyboard =  {
        bindTo: document
    };
}
var bpmnModeler  = new BpmnModeler(options);

//窗口依赖
var hotKeyWin = require('./provider/window/Hotkeys');
/**
 * 流程信息全局参数，判断流程的打开和保存状态
 */
var flowInfo = require("./provider/util/FlowInfo");
var cmdHelper = require('bpmn-js-properties-panel/lib/helper/CmdHelper');
var utils = require('bpmn-js-properties-panel/lib/Utils');
window.flowInfo = flowInfo;
var flowPropertyUtil = require("./provider/util/FlowPropertyUtil");
window.openDiagram = function(xml,id) {
	window.xmlStr = xml;//打开流程图的时候把这个设置到全局中去
    bpmnModeler.moddle.bimids.clear();
    bpmnModeler.importXML(xml, function (err) {

        if (err) {
            container.removeClass('with-diagram').addClass('with-error');
            container.find('.error pre').text(err.message);
            console.error(err);
        } else {
            container.removeClass('with-error').addClass('with-diagram');
            var element = getFlowElement(id);
            bpmnModeler.get('canvas').setProcessElement(element);
            updateFlowInfo(element);
            bpmnModeler.invoke(function () {
                bpmnModeler.resetCanvas();
            });
            bpmnModeler.invoke(function (commandStack) {
                //编辑流程图，点亮保存按钮
                var businessObject = element.businessObject;
                var cmd = cmdHelper.updateProperties(element, businessObject);
                commandStack.execute(cmd.cmd, cmd.context || {element : element});
            });
            // 暂时注释，不强制更新虚拟节点的出边为虚拟边 modified by liuguozhen at 2019.05.26 14:00
            //更新虚拟节点
            // flowPropertyUtil.updateVirtualEdge(bpmnModeler);
            if( window.isHasTaskInfoShow ){
                toolTip.addMarker(bpmnModeler);
            }
            bpmnModeler.invoke(function (eventBus) {
                eventBus.fire('import.success', { flowElement: element });
                eventBus.on('element.changed', function(event) {
                    flowInfo.isChanged = true;
                });
            });
        }
    });
}

// 从url中获取?后的参数 add by liuguozhen at 2020.05.18 16:49
function getQueryString(name) {
    var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
    var r = window.location.search.substr(1).match(reg);
    if (r != null) return unescape(r[2]);
    return null;
}

function saveSVG(done) {
    bpmnModeler.saveSVG(done);
}

function saveDiagram(done) {

    bpmnModeler.saveXML({ format: true }, function (err, xml) {
        done(err, xml);
    });
}
function saveDiagramToServer(done) {

    bpmnModeler.saveXML({ format: true }, function (err, xml) {
        done(err, xml);
    });
}

function registerFileDrop(container, callback) {

    function handleFileSelect(e) {
        e.stopPropagation();
        e.preventDefault();
        var files = e.dataTransfer.files;
        var file = files[0];
        var reader = new FileReader();
        reader.onload = function (e) {
            //流程展示窗口不允许拖入打开流程图
            if(  window.isOnlyShow == true){
                return;
            }
            var xml = e.target.result;
            callback(xml);
        };
        reader.readAsText(file);
    }
    function handleDragOver(e) {
        e.stopPropagation();
        e.preventDefault();
        e.dataTransfer.dropEffect = 'copy'; // Explicitly show this is a copy.
    }
    container.get(0).addEventListener('dragover', handleDragOver, false);
    container.get(0).addEventListener('drop', handleFileSelect, false);
}
////// file drag / drop ///////////////////////

// check file api availability
if (!window.FileList || !window.FileReader) {
    window.alert(
            'Looks like you use an older browser that does not support drag and drop. ' +
            'Try using Chrome, Firefox or the Internet Explorer > 10.');
} else {
    registerFileDrop(container, openDiagram);
}

// bootstrap diagram functions

var openDiagramXML =require("./provider/util/OpenDiagramXML");
var getNewDiagramXML = require("./provider/util/NewDiagramXML");

var propConfig = require("./provider/propconfig/RightMouseDownPropConfig");
var clickEventConfig = require("./provider/propconfig/ClickEventConfig");
var elementDefaultPorperty = require("./provider/propconfig/ElementDefaultPorperty");
var importEvent = require("./provider/event/ImportEvent");
var mouseEvent = require("./provider/event/MouseEvent");
var subFlowButtonEvent = require("./provider/event/SubFlowButtonEvent");
var toolTip = require("./provider/ToolTip/ToolTip");

$(document).on('ready', function () {
    if(!window.isComponent){
        propConfig(bpmnModeler);//实现右键菜单
    }
    clickEventConfig(bpmnModeler);//实现点击事件调用GWT
    elementDefaultPorperty(bpmnModeler);
    importEvent(bpmnModeler);
    if( window.isHasTaskInfoShow ){
        toolTip.init(bpmnModeler);
    }
    mouseEvent(bpmnModeler);
    subFlowButtonEvent(bpmnModeler);
     //添加新建按钮功能
    var newIcon = document.getElementById('new-icon');
    newIcon.onclick = function () {
          window.designer.showNewFlowWindow();
        //openDiagram(getNewDiagramXML('cccc', 'cccc','cccc'),'cccc');
    };
    /**
     * 全局方法，在GWT中调用
     */
   window.creatNewFlow = function(id, name,type){
       openDiagram(getNewDiagramXML(id, name,type),id);
   }
    //添加打开功能
    var openIcon = document.getElementById('open-icon');
    openIcon.onclick = function () {
        openDiagramXML(function(xml){
            flowInfo.CreatFrom = "FILE";
            flowInfo.readonly = false;
            openDiagram(xml);
        })
    };
    window.openLocalFlow = function(){
        openIcon.click();
    }
    //在线打开
    var openOnLine = document.getElementById('open-icon-online');
    openOnLine.onclick = function () {
        window.designer.showOpenOnlineWindow();
    };
    var copytime = 0;
    //实现剪切
    var cutIcon = document.getElementById('cut-icon');
    cutIcon.onclick = function () {
        bpmnModeler.invoke(function (selection, copyPaste, modeling, rules) {
            copyElements(selection, copyPaste);
            deleteElement(selection, modeling, rules)
        })
    };
    window.cutElement = function(){
        cutIcon.click();
    }
    //实现复制
    var copyIcon = document.getElementById('copy-icon');
    copyIcon.onclick = function () {
        bpmnModeler.invoke(function (selection, copyPaste, eventBus) {
            copyElements(selection, copyPaste);
        })
    };
    window.copyElement = function(){
        copyIcon.click();
    }
    //实现粘贴
    var pasteIcon = document.getElementById('paste-icon');
    pasteIcon.onclick = function () {
        bpmnModeler.invoke(function (mouseTracking, copyPaste) {
            var context = mouseTracking.getHoverContext();
            //重新设置粘贴位置，设置为固定值
            context.point.x = 580 + copytime;
            context.point.y = 230 + copytime;
            copyPaste.paste(context);
            copytime = copytime + 5;
        })
    };
    window.pasteElement = function(){
        pasteIcon.click();
    }
    //实现删除
    var deleteIcon = document.getElementById('delete-icon');
    deleteIcon.onclick = function () {
        bpmnModeler.invoke(function (selection, modeling, rules) {
            deleteElement(selection, modeling, rules);
        })
    };
    window.deleteElement = function(){
        deleteIcon.click();
    }
    //复制方法，在复制和剪切的时候调用
    function copyElements(selection, copyPaste) {
        var selectedElements = selection.get();
        copyPaste.copy(selectedElements);
        copytime = 0;
    }

    //删除方法，在删除和剪切的时候调用
    function deleteElement(selection, modeling, rules) {
        var selectedElements = selection.get();

        if (selectedElements.length) {
            var allowed = rules.allowed('elements.delete', { elements: selectedElements }),
                removableElements;

            if (allowed === false) {
                return;
            }
            else if (isArray(allowed)) {
                removableElements = allowed;
            }
            else {
                removableElements = selectedElements;
            }

            if (removableElements.length) {
                modeling.removeElements(removableElements.slice());
            }
        }
    }

    //实现放大
    var zoomInIcon = document.getElementById('zoom-in-icon');
    zoomInIcon.onclick = function () {
        bpmnModeler.invoke(function (zoomScroll) {
            zoomScroll.stepZoom(1);
        })
    };
    window.zoomInElement = function(){
        zoomInIcon.click();
    }
    //实现缩小
    var zoomOutIcon = document.getElementById('zoom-out-icon');
    zoomOutIcon.onclick = function () {
        bpmnModeler.invoke(function (zoomScroll) {
            zoomScroll.stepZoom(-1);
        })
    };
    window.zoonOutElement = function(){
        zoomOutIcon.click();
    }
    //实现还原
    var resetSizeIcon = document.getElementById('reset-size-icon');
    resetSizeIcon.onclick = function () {
        bpmnModeler.invoke(function (canvas, selection, modeling, rules) {
            canvas.zoom(1);
        })
    };
    window.resetSize = function(){
        resetSizeIcon.click();
    }
    //实现还原大小和位置
    var resetCanvasIcon = document.getElementById('reset-canvas-icon');
    resetCanvasIcon.onclick = function () {
        bpmnModeler.invoke(function () {
            bpmnModeler.resetCanvas();
        })
    };
    window.resetCanvas = function(){
        resetCanvasIcon.click();
    }
    //实现全屏
    var fullScreenIcon = $('#full-screen-icon');
    fullScreenIcon.click(function (e) {
        if ($(this).is('.disable')) {
            showUnableInfo();
            //除了阻止默认行为之外，还会阻止事件冒泡 结果相当于return false
            e.preventDefault();
            e.stopPropagation();
        } else {
            bpmnModeler.invoke(function () {
                bpmnModeler.fullCanvas();
            })
        }
    });
    window.fullScreen = function(){
        fullScreenIcon.click();
    }
    //实现居中1：1显示
    var centerIcon = $('#center-display-icon');
    centerIcon.click(function (e) {
        if ($(this).is('.disable')) {
            showUnableInfo();
            //除了阻止默认行为之外，还会阻止事件冒泡 结果相当于return false
            e.preventDefault();
            e.stopPropagation();
        } else {
            bpmnModeler.invoke(function () {
                bpmnModeler.centerDisplay();
            })
        }
    });
    window.centerDisplay = function(){
        centerIcon.click();
    }
    //实现undo
    var undoIcon = document.getElementById('undo-icon');
    undoIcon.onclick = function () {
        bpmnModeler.invoke(function (commandStack) {
            commandStack.undo();
        })
    };
    window.undo = function(){
        undoIcon.click();
    }
    //实现redo
    var redoIcon = document.getElementById('redo-icon');
    redoIcon.onclick = function () {
        bpmnModeler.invoke(function (commandStack) {
            commandStack.redo();
        })
    };
    window.redo = function(){
        redoIcon.click();
    }
    //保存到服务器
    var saveToServer = $('#save-icon');
    saveToServer.click(function (e) {
        if ($(this).is('.disable')) {
            showUnableInfo();
            //除了阻止默认行为之外，还会阻止事件冒泡 结果相当于return false
            e.preventDefault();
            e.stopPropagation();
        } else {
            window.designer.saveFlow2Server();
        }
    });
    //另存为到服务器
    var saveAsToServer = $('#saveas-icon');
    saveAsToServer.click(function (e) {
        if ($(this).is('.disable')) {
            showUnableInfo();
            //除了阻止默认行为之外，还会阻止事件冒泡 结果相当于return false
            e.preventDefault();
            e.stopPropagation();
        } else {
            window.designer.saveAs2Server();
        }
    });
    var saveBpmnIcon = $('#save-bpmn-icon');
    var downloadLink = $('#bpmn-download');
    saveBpmnIcon.click(function (e) {
        if ($(this).is('.disable')) {
            showUnableInfo();
            //除了阻止默认行为之外，还会阻止事件冒泡 结果相当于return false
            e.preventDefault();
            e.stopPropagation();
        } else {
            var bpmnText = '<span id="bpmnText"><span>';
            downloadLink.append(bpmnText);
            $('#bpmnText').click();
        }
    });
    window.saveBPMN = function(){
        saveBpmnIcon.click();
    }
    var saveSvgIcon = $('#save-svg-icon');
    var downloadSvgLink = $('#svg-download');
    saveSvgIcon.click(function (e) {
        if ($(this).is('.disable')) {
            showUnableInfo();
            //除了阻止默认行为之外，还会阻止事件冒泡 结果相当于return false
            e.preventDefault();
            e.stopPropagation();
        } else {
            var svgText = '<span id="svgText"><span>';
            downloadSvgLink.append(svgText);
            $('#svgText').click();
        }
    });
    window.saveSVG = function(){
        saveSvgIcon.click();
    }
    window.isButtonAble = false;
    function setEncoded(button, link, name, data) {
        var encodedData = encodeURIComponent(data);

        if (data) {
            window.isButtonAble = true;
            centerIcon.removeClass('disable');
            fullScreenIcon.removeClass('disable');
            saveToServer.removeClass('disable');
            saveAsToServer.removeClass('disable');
            button.removeClass('disable');
            link.attr({
                'href': 'data:application/bpmn20-xml;charset=UTF-8,' + encodedData,
                'download': name
            });
        } else {
            window.isButtonAble = false;
            centerIcon.addClass('disable');
            fullScreenIcon.addClass('disable');
            saveToServer.addClass('disable');
            saveAsToServer.addClass('disable');
            button.addClass('disable');
        }
    }

    var debounce = require('lodash/function/debounce');

    var exportArtifacts = debounce(function () {

        var id = flowInfo.flowId;
        if(id == "" || id == null){
            id = "diagram";
        };
        saveSVG(function (err, svg) {
            setEncoded(saveSvgIcon, downloadSvgLink, id +'.svg', err ? null : svg);
        });

        saveDiagram(function (err, xml) {
            setEncoded(saveBpmnIcon, downloadLink, id +'.bpmn', err ? null : xml);
        });

        saveDiagramToServer(function (err, xml) {
            if(err){
                console.log(err);
            }else{
                window.xmlStr = xml;
            }
        });
    }, 500);

    bpmnModeler.on('commandStack.changed', exportArtifacts);

    //实现热键展示
    var hotkeys = document.getElementById('keyboard');
    hotkeys.onclick = function(){
        hotKeyWin.show();
    }
    window.showHotkey = function(){
        hotKeyWin.show();
    }
});
function showUnableInfo(){
    if(window.isComponent){
        window.parent.showAlert("需要对流程图编辑后才能进行该操作","系统提示！","MESSAGE_WARN");
    }
}

var getFlowElement = function(id){
    var elementRegistry = bpmnModeler.get('elementRegistry');
    var element;
    var partID;
    if(id == null || id == undefined || typeof elementRegistry.get(id) == 'undefined'){
        var eles = elementRegistry._elements;
        for(var key in eles){
            var ele = elementRegistry.get(key);
            if(ele.type == 'bpmn:Process'){
                id = key;
                break;
            }
            if(ele.type == 'bpmn:Participant'){
                partID = key;
                break;
            }
        }
    }
    element = elementRegistry.get(id);
    if(typeof element == 'undefined'){
        var partEle = elementRegistry.get(partID);
        element = partEle.businessObject.processRef;
        element.businessObject = partEle.businessObject.processRef;
    }
    return element;
}
//根据id完善FlowInfo里面的信息,使信息同步
var updateFlowInfo = function(element){
    var businessObject = element.businessObject;
    flowInfo.flowId =  businessObject.get('id');
    flowInfo.flowName = businessObject.get('name');
    flowInfo.flow_op_type = businessObject.get('BIMFlowType');
    console.log(flowInfo);
}
//校验流程id是否合法
window.validateFlowId = function(id){
    return utils.validateFlowId(id);
}

var propertyUtil = require("./provider/propconfig/PropertyUtil");
window.getAllElementProperty = function(){
    var elementRegistry = bpmnModeler.get('elementRegistry');
    var eles = elementRegistry._elements;
    var properties = {};
    for(var key in eles){
        var businessObject;
        var ele = eles[key].element;
        var type = ele.type;

        if(type == 'bpmn:Participant'){
            businessObject = ele.businessObject.processRef;
        }else if(type == 'bpmn:Collaboration'){
            continue;
        }else{
            businessObject = ele.businessObject;
        }

        var obj = propertyUtil.formatProps(businessObject);
        var typeKey = type.split(':')[1];
        if(typeKey == undefined) {
            continue;
        }
        var props = properties[typeKey];
        if(props == null|| props == undefined){
            props = [];
        }
        props[props.length] = obj;
        properties[typeKey] = props;
    }
    return properties;
}
