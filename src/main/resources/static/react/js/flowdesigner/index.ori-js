'use strict';

var newDiagramXML = function(openDiagram){
    var openfile = $("#fileInput");
    var fileInput = document.getElementById("fileInput");//隐藏的file文本ID
    fileInput.click();//加一个触发事件

    openfile.change(function (e) {
        var files = document.getElementById("fileInput").files;
        openDiagramByFile(files,openDiagram);
        //实现file重置，可以连续打开同一个文件
        openfile.val("")
    });

}
module.exports = newDiagramXML;


//从文件路径中解析出文件名称
function getFileName(filepath){
    var array = filepath.split("\\");
    var file = array[array.length-1];
    var i = file.lastIndexOf('.');
    var fileName = file.substring(0,i);
    console.log(fileName);
    return fileName;
}
//实现文本加载，并打开文本文件
function openDiagramByFile(f,openDiagram) {
    //检测浏览器是否支持FileReader对象
    if (typeof FileReader == 'undefined') {
        window.parent.showAlert("检测到您的浏览器不支持FileReader对象！","系统提示","MESSAGE_WARN");
        //alert("检测到您的浏览器不支持FileReader对象！");
    }
    var tmpFile = f[0];
    if (tmpFile) {
        var reader = new FileReader();
        reader.readAsText(tmpFile);
        reader.onload = function (e) {
            var xml = e.target.result;
            openDiagram(xml);
        }
    }
}


