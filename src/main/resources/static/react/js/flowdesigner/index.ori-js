                        map[map.length] = properties;
                    }
                    var propertyArr = [];
                    for (var k in value) {
                        var property = elementHelper.createElement('ospflow:Property', {name: k, value: value[k]}, properties, bpmnFactory);
                        propertyArr.push(property);
                    }
                    properties.values = propertyArr;
                } else {
                    element[key] = newProp[key];
                }
            }
        });
    });
}

module.exports = ElementDefaultPorperty;
