},{}],8:[function(require,module,exports){
/**
 * 流程图展示时，toolTip显示流程信息
 */
'use strict';

var d3 = require('../js/d3');


var ToolTip = function () {
}
ToolTip.init = function (bpmnModeler) {
    //添加事件 显示tootip
    bpmnModeler.invoke(function (eventBus, bpmnFactory, commandStack) {
        var tooltip = d3.selectAll(".userInfoTooltipStyle");
        var elementTooltipDiv = d3.select("#userInfoTooltip");

        eventBus.on('element.click', function (event) {
            var tooltipType  = window.designer.getToolTipInfoStyle();
            if(tooltipType != 0 && tooltipType != 3) return;
            var element = event.element;
            tooltip.style("opacity", "0");
            tooltip.style("display", "none");
            var isShow = isShowTooltips(element);
            if (isShow == false)return;

            var nodeTag = element.businessObject.BIMId;
            var nodeName = element.businessObject.name;
            var flowid = element.parent.id;
            var sourceEdgeId = "";

            // 如果子流程的前一个节点则单独处理
            /*
            1.获取所有出去的边和对应的子流程  读取子流程的开始节点
            2.
             */


            //如果这个地方是子流程 的开始节点的话，则去查询子流程的上一个节点的信息
            if(element.parent.type == 'bpmn:SubProcess' && element.type == 'bpmn:StartEvent'){
                nodeTag = element.parent.incoming[0].source.businessObject.BIMId;
                flowid = element.parent.incoming[0].source.parent.id;
            }
            if(element.parent.type == 'bpmn:SubProcess'){
                //此处的flowid包含来源边的id信息，所以需要把来源边的id传递过去，支持主流程配置多个相同的子流程
                sourceEdgeId = element.parent.incoming[0].id;
            }
            var html = window.designer.getTaskElementInfo(flowid, nodeTag, nodeName,sourceEdgeId);
            d3.select("#userInfoTooltip").html(html);
            var node = event.gfx.node;
            var rect = node.getBoundingClientRect();
            var top = rect.top;
            var left = rect.left;
            var height = rect.height;
            var width = rect.width;
            var tpx = left+width/2 - 102.5;
            var tpy = top+height;
            elementTooltipDiv.style("left", tpx +  "px").style("top", tpy + "px");
            tooltip.style("opacity", "1");
            tooltip.style("display", "inline");
        });
        eventBus.on('canvas.viewbox.changing', function (event) {
            var tooltipType  = window.designer.getToolTipInfoStyle();
            if(tooltipType !=0) return;
            tooltip.style("opacity", "0");
            tooltip.style("display", "none");
        });
    });

    //添加事件 显示tootip
    bpmnModeler.invoke(function (eventBus, bpmnFactory, commandStack) {
        var tooltip = d3.selectAll(".taskInfoTooltipStyle");
        var elementTooltipDiv = d3.select("#taskInfoTooltip");
        eventBus.on('element.hover', function (event) {
            var tooltipType  = window.designer.getToolTipInfoStyle();
            if(tooltipType != 1 && tooltipType != 2) return;
            var element = event.element;
            var isShow = isShowTooltips(element);
            if (isShow == false)return;
            tooltip.style("opacity", "0");
            tooltip.style("display", "none");
            var nodeTag = element.businessObject.BIMId;
            var nodeName = element.businessObject.name;
            var flowid = element.parent.id;
            //如果这个地方是子流程 的开始节点的话，则去查询子流程的上一个节点的信息 //注释掉 子流程的开始节点不显示tooltip
//            if(element.parent.type == 'bpmn:SubProcess' && element.type == 'bpmn:StartEvent'){
//                nodeTag = element.parent.incoming[0].source.businessObject.BIMId;
//                flowid = element.parent.incoming[0].source.parent.id;
//            }
            var sourceEdgeId ="";
            if(element.parent.type == 'bpmn:SubProcess'){
                //此处的flowid包含来源边的id信息，所以需要把来源边的id传递过去，支持主流程配置多个相同的子流程
                sourceEdgeId = element.parent.incoming[0].id;
            }
            var html = window.designer.getTaskElementInfo(flowid, nodeTag, nodeName, sourceEdgeId);
            d3.select("#taskInfoTooltip").html(html);
            var node = event.gfx.node;
            var rect = node.getBoundingClientRect();
            var top = rect.top;
            var left = rect.left;
            var height = rect.height;
            var width = rect.width;
            var tpx = left+width/2 - 125;
            var tpy = top+height;
            elementTooltipDiv.style("left", tpx +  "px").style("top", tpy + "px");
            tooltip.style("opacity", "1");
            tooltip.style("display", "inline");
        });
        eventBus.on('element.out', function (event) {
            var tooltipType  = window.designer.getToolTipInfoStyle();
            if(tooltipType != 1 && tooltipType != 2) return;
            tooltip.style("opacity", "0");
            tooltip.style("display", "none");
        });
    });
}

//子流程的开始节点和结束节点 不显示tootip  整个流程的结束节点也不显示tooltip
function isShowTooltips(element){
    if (element.type != 'bpmn:Task' && element.type != 'bpmn:StartEvent'){
        return false;
    }
    if(element.parent.type == 'bpmn:SubProcess' && element.type == 'bpmn:StartEvent'){
         return false;
    }
    return true;
}

window.openIMTalk = function (imUser){
    $.ajax({
        //要用post方式
        type: "Post",
        //方法所在页面和方法名
        url: "http://127.0.0.1:12306/OpenChat?IMUserID="+ imUser,
        success: function(data) {
            console.log(data);
            console.log('调用联信打开窗口成功');
        },
        error: function(err) {
            console.log(err);
            window.parent.showAlert("打开联信聊天窗口失败，请先启动联信","MESSAGE_WARN");
        }
    });
}

window.custonTooltipFunction = function (flowId, nodeId, sourceEdgeId){
    window.designer.customTooltipClick(flowId, nodeId, sourceEdgeId);
}



ToolTip.addMarker = function (bpmnModeler) {
    //添加事件 显示tootip
    bpmnModeler.invoke(function (eventBus, bpmnFactory, commandStack) {
        var canvas = bpmnModeler.get('canvas');
        var elementRegistry = bpmnModeler.get('elementRegistry');
        var elementList = elementRegistry.getAll();
        var hasMarkered = [];
        for ( var i = 0; i < elementList.length; i++ ) {
            var element = elementList[i];
            if (element.type != 'bpmn:Task' && element.type != 'bpmn:StartEvent' && element.type != 'bpmn:EndEvent') continue;
            if(element.parent.type == 'bpmn:SubProcess' && element.type == 'bpmn:StartEvent'){
                var parent = element.parent;
                var connection = parent.incoming[0];
                var sourceNode = connection.source;
                var nodeTag = element.businessObject.BIMId;
                var flowid = element.parent.id;

                //如果是子流程的开始节点的话，则把开始节点的样式反映到前面的虚拟节点上。开始节点的样式不变
                hasMarkered.push(sourceNode.id);
                //去掉原节点上标记的样式
                var nodeTag2 = sourceNode.businessObject.BIMId;
                var flowid2 = sourceNode.parent.id;
                var style2 = window.designer.getElementStyle(flowid2, nodeTag2);
                canvas.removeMarker(sourceNode, style2);

                //修改子流程不进入时，子流程前的任务节点颜色渲染不上的问题 add by LiuQ  2019-09-04
                var style = window.designer.getElementStyle(flowid, nodeTag);
                if (style == null || style == '' || style == undefined){
                    style = style2;
                }
                canvas.addMarker(sourceNode, style);

            }else{
                if(hasMarkered.indexOf(element.id)>0){
                    continue;
                }
                var nodeTag = element.businessObject.BIMId;
                var flowid = element.parent.id;
                var style = window.designer.getElementStyle(flowid, nodeTag);
                canvas.addMarker(element, style);
            }
        }
    });
}

module.exports = ToolTip;


},{"../js/d3":12}],9:[function(require,module,exports){
'use strict';
var EventConfig = function(bpmnModeler){
    bpmnModeler.invoke(function (eventBus) {
        eventBus.on('import.success', function(event) {
            var flow = event.flowElement;
            window.designer.importSuccess(flow);
        });
    });
}

module.exports = EventConfig;
},{}],10:[function(require,module,exports){
/***
 * 鼠标事件的添加与移除
 */
var forEach = require('lodash/collection/forEach');

'use strict';
var MouseEvent = function(bpmnModeler){
    bpmnModeler.invoke(function (eventBus, bpmnFactory, commandStack) {
        eventBus.on('connection.pointevent.remove', function(event) {
            var element = event.element;
            var canvas = bpmnModeler.get('canvas');
            var container;
            if (!element.id) {
                element = canvas._elementRegistry.get(element);
            }
            // we need to access all
            container = canvas._elementRegistry._elements[element.id];

            if (!container) {
                return;
            }

            forEach([ container.gfx, container.secondaryGfx ], function(gfx) {
                if (gfx) {
                    $(gfx.node.childNodes[1]).removeClass('djs-hit');
                    $(gfx.node.childNodes[1]).addClass('djs-no-hit');
                }
            });
            canvas.removeMarker(element, 'selected');
        });
    });

    bpmnModeler.invoke(function (eventBus, bpmnFactory, commandStack) {
        eventBus.on('connection.pointevent.add', function(event) {
            var element = event.element;
            var canvas = bpmnModeler.get('canvas');
