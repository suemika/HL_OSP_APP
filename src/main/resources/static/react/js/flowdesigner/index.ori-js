                 if(incomings != null){
                     //现在的流程进入子流程的只有一条边，所以此处就默认0就好了
                     var incoming = incomings[0];
                     var flowSource = incoming.sourceRef;
                     var flowSourceNodeProperty = propertyUtil.getElementAllProperty(flowSource);
