'use strict';

var is = require('bpmn-js/lib/util/ModelUtil').is,
    find = require('lodash/collection/find');

var getBusinessObject = require('bpmn-js/lib/util/ModelUtil').getBusinessObject,
    utils = require('bpmn-js-properties-panel/lib/Utils'),
    cmdHelper = require('bpmn-js-properties-panel/lib/helper/CmdHelper'),
    elementHelper = require('bpmn-js-properties-panel/lib/helper/ElementHelper');

/**
* Get first ospflow:Scripts object for a specific bpmn:ExtensionElements
* business object.
*
* @param {ModdleElement} extensionElements
*
* @return {ModdleElement} a ospflow:Scripts object
*/
function getScriptsElementInsideExtensionElements(extensionElements) {
    return find(extensionElements.values, function(elem) {
        return is(elem, 'ospflow:CustomFunction');
    });
}

function ScriptProps(group, element, bpmnFactory, commandStack) {

    var bo;

    if (is(element, 'bpmn:Task') || is(element, "bpmn:StartEvent") || is(element, "bpmn:EndEvent") || is(element, "bpmn:SequenceFlow")) {

        bo = getBusinessObject(element);
        if ( !bo ) return;

        var cmd;

        group.entries.push({
            id : 'customFunction',
            description : '自定义函数',
            label : '自定义函数',
            html: '<div class="cam-add-listener">' +
                '<button style="width: 100px" type="button" data-action="addListener">自定义函数</button>' +
                '</div>',

            get: function (element, propertyName) {
                var values = {};
                return values;
            },

            set: function (element, values, containerElement) {
                return cmd;
            },
            // 打开自定义函数窗口
            addListener: function(element, inputNode) {
                // 当前节点的函数脚本
                var scriptMap = {};
                var extensionElements = bo.extensionElements;
                if ( extensionElements ) {
                    var scriptElements = getScriptsElementInsideExtensionElements(extensionElements);
                    if ( scriptElements ) {
                        var scripts = scriptElements.get('customFunction');
                        for ( var i = 0; scripts && i < scripts.length; i++ ) {
                            var scriptElement = scripts[i];
                            var functionName = scriptElement.functionName;
                            var functionValue = scriptElement.text;
                            scriptMap[functionName] = functionValue;
                        }
                    }
                }
                var that = this;
                window.setScriptMap = function(scriptMap){
                    that.onScriptEditEnd(element,scriptMap)
                }
                window.designer.scriptEdit(element,scriptMap);

                //flowScriptEditer.openScriptWindow(element, this.onScriptEditEnd, scriptMap);
                return true;
            },

            onScriptEditEnd: function (element, scriptMap) {

                if ( scriptMap === undefined || scriptMap === null ) {
                    return;
                }
                // 创建extensionElements
                var extensionElements = bo.extensionElements;
                if (!extensionElements) {
                    extensionElements = elementHelper.createElement('bpmn:ExtensionElements', { values: [] }, bo, bpmnFactory);
                    bo.extensionElements = extensionElements;
                }

                var extensionValues = extensionElements.get('values');
                // 创建scriptElements
                var scriptElements = getScriptsElementInsideExtensionElements(extensionElements);
                if ( !scriptElements ) {
                    scriptElements = elementHelper.createElement('ospflow:CustomFunction', { customFunction: [] }, extensionElements, bpmnFactory);
                    extensionValues.push(scriptElements);
                }

                // 创建函数脚本
                var scripts = scriptElements.get('customFunction');
                // 清空已经存在的脚本，重新组织
                if ( scripts && scripts.length > 0 ) {
                    scripts.splice(0, scripts.length);
                }

                for ( var functionName in scriptMap ) {
                    var scriptStr = scriptMap[functionName];
                    if ( !scriptStr || scriptStr.trim() == '' ) {
                        continue;
                    }
                    var scriptElement = elementHelper.createElement('ospflow:Script', { functionName: functionName }, scriptElements, bpmnFactory);
                    scriptElement.text = scriptStr;
                    scripts.push(scriptElement);
                }
                var cmd = cmdHelper.updateProperties(element, { extensionElements: extensionElements });
                // 执行更新操作
                commandStack.execute(cmd.cmd, cmd.context || {element : element});
            }
        });
    }
}

module.exports = ScriptProps;
