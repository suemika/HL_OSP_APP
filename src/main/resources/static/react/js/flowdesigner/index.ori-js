                seq: -21,
                parallel: -22,
                compensation: -42,
                loop: -18,
                adhoc: 10
            };
        } else {
            position = {
                seq: -3,
                parallel: -6,
                compensation: -27,
                loop: 0,
                adhoc: 10
            };
        }

        forEach(taskMarkers, function (marker) {
            renderer(marker)(p, element, position);
        });

        if (obj.isForCompensation) {
            renderer('CompensationMarker')(p, element, position);
